NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://irctc:irctc@localhost:5432/irctc
REDIS_URL=redis://localhost:6379
# Auth — generate a secret with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Email (Mailpit in dev: inbox at http://localhost:8025)
APP_URL=http://localhost:3000
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=IRCTC <no-reply@irctc.local>

# Razorpay, TEST MODE ONLY (live keys are refused at startup). Get test keys at
# https://dashboard.razorpay.com → switch to Test Mode → Account & Settings → API Keys.
# Leave empty to run without payments (the payment endpoints answer 503).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Only needed to receive webhooks (Razorpay must reach your server, e.g. through ngrok).
RAZORPAY_WEBHOOK_SECRET=

# Seed admin (used by `npx prisma db seed`)
ADMIN_EMAIL=admin@irctc.local
ADMIN_PASSWORD=admin
