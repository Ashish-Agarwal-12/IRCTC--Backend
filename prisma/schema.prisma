generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum TokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum CoachClass {
  SL          // Sleeper
  AC3         // 3rd AC
  AC2         // 2nd AC
  AC1         // 1st AC
  CC          // Chair Car
}

enum Quota {
  GENERAL
  TATKAL
  LADIES
  SENIOR_CITIZEN
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum BerthType {
  LOWER
  MIDDLE
  UPPER
  SIDE_LOWER
  SIDE_UPPER
  WINDOW
  AISLE
}

// One Payment row per gateway order. A user may open checkout more than once for a booking, so a
// booking can have several orders; at most one of them confirms it, and money on any other is refunded.
enum PaymentStatus {
  CREATED         // order created at the gateway; waiting for the user to pay
  CAPTURED        // money received, and it confirmed the booking
  REFUND_PENDING  // money received but the booking couldn't use it (hold expired, already paid): refund owed
  REFUNDED        // that refund was issued at the gateway
  EXPIRED         // never paid, and the booking no longer needs it
}

// Emails we owe the user. Written in the same transaction as the change they report (see OutboxMessage).
enum NotificationType {
  BOOKING_CONFIRMED   // ticket PDF attached
  REFUND_INITIATED    // paid after the hold ran out; the money is going back
  BOOKING_CANCELLED   // some or all passengers cancelled (by the user, or waitlisted at chart time)
  STATUS_CHANGED      // passengers moved up: WL → RAC, RAC → CNF (fresh ticket attached)
}

enum RefundStatus {
  PENDING     // owed; recorded in the cancellation's transaction
  PROCESSED   // issued at the gateway
}

enum OutboxStatus {
  PENDING   // waiting to be sent (or retried at nextAttemptAt)
  SENT
  FAILED    // gave up after the maximum attempts; needs a human
}

enum Gender {
  MALE
  FEMALE
  TRANSGENDER
}

enum PassengerStatus {
  CONFIRMED
  RAC
  WAITLISTED
  CANCELLED
}

enum ScheduleStatus {
  SCHEDULED
  CHART_PREPARED
  DEPARTED
  CANCELLED
}

model Passenger {
  id              String            @id @default(uuid())
  bookingId       String
  position        Int               // 1-based order within the booking, as the user entered them
  name            String
  age             Int
  gender          Gender
  requestedBerth  BerthType?
  status          PassengerStatus
  racNumber       Int?              // current position in the RAC queue (1 = next to get a berth); null unless RAC
  waitlistNumber  Int?              // current position on the waitlist; null unless WAITLISTED

  booking         Booking           @relation(fields: [bookingId], references: [id])
  allocation      SeatAllocation?

  @@unique([bookingId, position])
}

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  phone                 String?   @unique
  passwordHash          String  
  firstName             String
  lastName              String
  role                  Role      @default(USER)
  bookings              Booking[]
  refreshTokens         RefreshToken[]
  verificationTokens    VerificationToken[]
  isEmailVerified       Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Station {
  id                    String    @id @default(uuid())
  code                  String    @unique
  name                  String    
  city                  String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  routeStops            RouteStop[]
}

model Train {
  id                    String    @id @default(uuid())
  number                String    @unique
  name                  String    
  runningDays           Weekday[]                 // days the train leaves its origin station
  departureMinutes      Int                       // origin departure, minutes after midnight (16:55 = 1015)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  routeStops            RouteStop[]
  schedules             TrainSchedule[]  
  coaches               Coach[]                 
}

model RouteStop {
  id                    String    @id @default(uuid())
  trainId               String    
  stationId             String    
  sequence              Int            // 1 = origin, 2, 3,  .... terminus
  arrivalMinutes        Int?           // minutes after origin deaprture; null at origin
  departureMinutes      Int?           // null at terminus
  distanceKm            Int            // Cumulative from origin, for fare calculation
  bookingsFrom          Booking[]      @relation("BookingFrom")
  bookingsTo            Booking[]      @relation("BookingTo")

  train     Train     @relation(fields: [trainId], references: [id])
  station   Station   @relation(fields: [stationId], references: [id])

  @@unique([trainId, sequence])
  @@index([stationId])
}


model TrainSchedule {
  id                    String          @id @default(uuid())
  trainId               String    
  journeyDate           DateTime        @db.Date    
  status                ScheduleStatus  @default(SCHEDULED)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  chartPreparedAt       DateTime?       // set by the chart-preparation job; null until then
  inventories           SeatInventory[]
  bookings              Booking[]
  allocations           SeatAllocation[]
  train Train @relation(fields: [trainId], references: [id])

  @@unique([trainId, journeyDate])
  @@index([journeyDate])
}

model Coach {
  id                    String          @id @default(uuid())
  trainId               String
  code                  String // "B1", "A2", "S5"
  class                 CoachClass

  train Train @relation(fields: [trainId], references: [id])
  seats Seat[]

  @@unique([trainId, code])
}


model Seat {
  id                    String            @id @default(uuid())
  coachId               String
  number                Int
  berthType             BerthType
  coach                 Coach             @relation(fields: [coachId], references: [id])
  allocations           SeatAllocation[]
  
  @@unique([coachId, number])
}

model SeatInventory {
  id                      String            @id @default(uuid())
  scheduleId              String
  class                   CoachClass
  quota                   Quota
  totalSeats              Int
  availableSeats          Int
  racCapacity             Int               @default(0)
  racBooked               Int               @default(0)
  waitlistBooked          Int               @default(0)           // waitlisted passengers now; next WL number = waitlistBooked + 1
  updatedAt               DateTime          @updatedAt

  schedule TrainSchedule @relation(fields: [scheduleId], references: [id])

  @@unique([scheduleId, class, quota])
}


model Booking {
  id              String                @id @default(uuid())
  pnr             String                @unique
  userId          String
  scheduleId      String
  fromStopId      String
  toStopId        String
  class           CoachClass
  quota           Quota
  status          BookingStatus         @default(PENDING_PAYMENT)
  totalFare       Int                   // paise
  holdExpiresAt   DateTime?
  idempotencyKey  String                @unique
  contactEmail    String
  contactPhone    String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  user  User                @relation(fields: [userId], references: [id])

  schedule  TrainSchedule   @relation(fields: [scheduleId], references: [id])

  fromStop    RouteStop     @relation("BookingFrom", fields: [fromStopId], references:[id])
  toStop      RouteStop     @relation("BookingTo", fields: [toStopId], references: [id])
  passengers Passenger[]    
  payments   Payment[]
  outbox     OutboxMessage[]
  refunds    Refund[]
  
  @@index([userId])
  @@index([scheduleId])
  @@index([status, holdExpiresAt])
}

model Payment {
  id                String          @id @default(uuid())
  bookingId         String
  gatewayOrderId    String          @unique   // Razorpay order_..., created by POST /payments/orders
  gatewayPaymentId  String?         @unique   // Razorpay pay_..., once the user pays
  refundId          String?                   // Razorpay rfnd_..., once refunded
  amount            Int                       // paise; always the booking's totalFare
  currency          String          @default("INR")
  status            PaymentStatus   @default(CREATED)
  lastError         String?                   // latest failed attempt, e.g. "Card declined"
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  booking           Booking         @relation(fields: [bookingId], references: [id])
  refunds           Refund[]

  @@index([bookingId])
  @@index([status, createdAt])                // the reconciliation job's scan
}

// Money owed back after a cancellation (partial or full). Separate from Payment's own
// REFUND_PENDING, which covers a whole payment that couldn't be used at all.
model Refund {
  id               String        @id @default(uuid())   // also sent to Razorpay in the refund's notes, to make retries safe
  bookingId        String
  paymentId        String                                // our Payment row (the captured one)
  amount           Int                                   // paise
  reason           String                                // e.g. "Cancelled by user: 2 passengers"
  status           RefundStatus  @default(PENDING)
  gatewayRefundId  String?       @unique                 // Razorpay rfnd_...
  lastError        String?
  createdAt        DateTime      @default(now())
  processedAt      DateTime?

  booking          Booking       @relation(fields: [bookingId], references: [id])
  payment          Payment       @relation(fields: [paymentId], references: [id])

  @@index([status, createdAt])
  @@index([bookingId])
}

// Transactional outbox. "Booking confirmed" and "send the ticket email" must both happen or neither:
// writing the email as a row in the same transaction as the confirmation guarantees that, and a
// worker (outbox.ts) delivers the rows afterwards, retrying until it succeeds.
model OutboxMessage {
  id             String            @id @default(uuid())
  type           NotificationType
  bookingId      String
  status         OutboxStatus      @default(PENDING)
  attempts       Int               @default(0)
  nextAttemptAt  DateTime          @default(now())   // also a lease: pushed ahead while a worker is sending
  lastError      String?
  payload        Json?                               // details known only at enqueue time (e.g. what a cancellation refunded)
  sentAt         DateTime?
  createdAt      DateTime          @default(now())

  booking        Booking           @relation(fields: [bookingId], references: [id])

  @@index([status, nextAttemptAt])  // the worker's scan
  @@index([bookingId])
}

// Webhook deliveries already processed, keyed by Razorpay's x-razorpay-event-id. Razorpay retries
// a delivery until it gets a 2xx, so the same event can arrive several times.
model PaymentEvent {
  id          String    @id               // x-razorpay-event-id
  type        String                      // e.g. "payment.captured"
  receivedAt  DateTime  @default(now())
}

model SeatAllocation {
  id          String   @id @default(uuid())
  scheduleId  String
  seatId      String
  passengerId String   @unique
  createdAt   DateTime @default(now())

  schedule  TrainSchedule @relation(fields: [scheduleId], references: [id])
  seat      Seat          @relation(fields: [seatId], references: [id])
  passenger Passenger     @relation(fields: [passengerId], references: [id])

  @@unique([scheduleId, seatId])
}

// One row per issued refresh token. Rotation: every /auth/refresh revokes the presented token and
// issues a new one in the same family. Presenting an already-revoked token means it was stolen
// and replayed, so the whole family (that login session) is revoked.
model RefreshToken {
  id            String    @id @default(uuid())
  userId        String
  tokenHash     String    @unique         // SHA-256 of the token; the raw token is never stored
  familyId      String                    // shared by every token descended from one login
  expiresAt     DateTime
  revokedAt     DateTime?
  replacedById  String?                   // the token issued when this one was rotated
  createdAt     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([familyId])
}

// Single-use tokens emailed to the user (verify email, reset password).
model VerificationToken {
  id            String        @id @default(uuid())
  userId        String
  purpose       TokenPurpose
  tokenHash     String        @unique
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime      @default(now())

  user          User          @relation(fields: [userId], references: [id])

  @@index([userId])
}

// Fare per class: baseFare + perKm * distance. Amounts in paise (integers), never floating-point
// rupees: 0.1 + 0.2 !== 0.3 in JavaScript, and money must add up exactly.
model FareRule {
  class          CoachClass  @id
  baseFare       Int                // paise
  perKm          Int                // paise per km
  updatedAt      DateTime    @updatedAt
}
